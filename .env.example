# SDEC-ERP backend — environment variables.
# Copy to .env and fill in real values. Never commit .env.

# ── Server ──────────────────────────────────────────────────────────────
# Local only. On Render leave it unset — Render injects PORT itself.
PORT=3002

# ── Database (PostgreSQL / Neon) ────────────────────────────────────────
# `npm run dev` (NODE_ENV=development) uses DATABASE_URL_DEV;
# `npm start` (NODE_ENV=production, Render) uses DATABASE_URL_PROD.
# DATABASE_URL is the fallback when the matching one is unset.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL_DEV=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL_PROD=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── Auth ────────────────────────────────────────────────────────────────
# Signs login tokens. Required, min 32 chars. Changing it logs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_TOKEN_SECRET=

# ── Frontend / links ────────────────────────────────────────────────────
# Web app URL: Socket.IO allowed origin, links in emails and task invites.
FRONTEND_URL=http://localhost:3000
# Optional: extra Socket.IO origins, comma-separated (overrides FRONTEND_URL there).
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Optional: base URL for WhatsApp task-invite links (defaults to FRONTEND_URL).
# APP_INVITE_URL=https://app.example.com

# ── Email (SendGrid) ────────────────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=you@example.com

# ── File uploads (Cloudinary) ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google Calendar (meetings) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=
# Dev only, behind a corporate proxy: trust an extra root CA (PEM path).
# GOOGLE_CA_CERT_PATH=
# Dev only, NEVER in production: disables TLS verification for Google calls.
# GOOGLE_INSECURE_TLS=false

# ── Phone numbers ───────────────────────────────────────────────────────
# Optional. Country code and digit count assumed for numbers typed without one.
# DEFAULT_PHONE_COUNTRY_CODE=+91
# DEFAULT_PHONE_NATIONAL_LENGTH=10

# ── Push notifications (Firebase Cloud Messaging) ───────────────────────
# Service-account JSON for project my-task-85ec4, as one line of JSON or base64 of it.
# Unset = push disabled (one warning at boot). Never commit it.
# FIREBASE_SERVICE_ACCOUNT=
# Shared secret for POST /api/internal/due-reminders (sent as X-Cron-Secret).
# Unset = that endpoint always answers 401.
# CRON_SECRET=
