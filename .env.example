# SDEC ERP backend — environment variables. Copy to .env (git-ignored) and fill in.
# Never commit real values. All of these are read server-side only.

PORT=3001
FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS=            # optional, comma-separated extra origins

# Database — NODE_ENV=production uses DATABASE_URL_PROD, otherwise DATABASE_URL_DEV;
# DATABASE_URL is the fallback for either.
DATABASE_URL=your_database_connection_string
DATABASE_URL_DEV=your_development_database_url
DATABASE_URL_PROD=your_production_database_url

# Signs login tokens (long random string).
AUTH_TOKEN_SECRET=your_auth_token_secret

# File uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=your_email_address

# Google Calendar integration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=your_google_redirect_uri
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# AI Assistant (Anthropic Claude Messages API). Without ANTHROPIC_API_KEY the
# assistant answers 503 "not configured"; the rest of the ERP is unaffected.
# Production: use a dedicated Anthropic service-account key set on the backend host.
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=      # optional proxy/gateway; default https://api.anthropic.com
