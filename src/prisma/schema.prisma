generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model column_config {
  id           Int      @id @default(autoincrement())
  table_name   String   @db.VarChar(255)
  column_key   String   @db.VarChar(255)
  column_label String   @db.VarChar(255)
  is_visible   Boolean? @default(true)
  order_index  Int

  @@unique([table_name, column_key], map: "unique_table_column")
}

model kanban_boards {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(255)
  goal           String?
  description    String?
  status         String           @default("Planned") @db.VarChar(50)
  startDate      DateTime?        @db.Timestamp(6)
  endDate        DateTime?        @db.Timestamp(6)
  estimatedHours Float?           @default(0)
  capacity       Float?           @default(0)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  created_by     Int?
  projectId      String?          @map("project_id") @db.VarChar(255)
  project        projects?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator        users?           @relation("BoardCreator", fields: [created_by], references: [id], onDelete: SetNull)
  columns        kanban_columns[]
  tasks          kanban_tasks[]
}

model kanban_columns {
  id          String         @id @db.VarChar(255)
  label       String         @db.VarChar(255)
  order_index Int
  board_id    Int?
  board       kanban_boards? @relation(fields: [board_id], references: [id], onDelete: Cascade)
}

model kanban_tasks {
  id             String          @id @db.VarChar(255)
  title          String          @db.VarChar(255)
  description    String?
  priority       String          @db.VarChar(50)
  assignee       String          @db.VarChar(255)
  status         String          @db.VarChar(255)
  dueDate        String          @db.VarChar(50)
  order_index    Int?            @default(0)
  storyPoints    Float?          @default(0)
  board_id       Int?
  estimatedHours Float?          @default(0) @map("estimated_hours")
  actualHours    Float?          @default(0) @map("actual_hours")
  originTaskId   String?         @map("origin_task_id") @db.VarChar(255)
  activity_logs  activity_logs[]
  attachments    task_attachments[]
  discussions    task_discussions[]
  discussion_reads task_discussion_reads[]
  board          kanban_boards?  @relation(fields: [board_id], references: [id], onDelete: Cascade)
}

model projects {
  id              String            @id @db.VarChar(255)
  name            String            @db.VarChar(255)
  description     String?
  status          String            @default("active") @db.VarChar(50)
  startDate       String?           @db.VarChar(50)
  endDate         String?           @db.VarChar(50)
  is_archived     Boolean?          @default(false)
  owner_id        Int?
  owner           users?            @relation("ProjectOwner", fields: [owner_id], references: [id], onDelete: SetNull)
  createdAt       DateTime?         @default(now()) @db.Timestamp(6)
  updatedAt       DateTime?         @default(now()) @updatedAt @db.Timestamp(6)
  blockers        Blocker[]
  activity_logs   activity_logs[]
  kanban_boards   kanban_boards[]
  project_members project_members[]
  meetings        Meeting[]
  bugs            bugs[]
  documents       project_documents[]
}

model project_members {
  id              Int      @id @default(autoincrement())
  project_id      String   @db.VarChar(255)
  user_id         Int
  role            String   @default("viewer") @db.VarChar(50)
  capacity_points Float?   @default(0)
  project         projects @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user            users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([project_id, user_id], map: "unique_project_member")
}

model roles {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(255)
  description String?   @default("")
  permissions Json?     @default("[]")
  createdAt   DateTime? @default(now()) @db.Timestamp(6)
}

model users {
  id                   Int       @id @default(autoincrement())
  name                 String    @db.VarChar(255)
  email                String    @unique @db.VarChar(255)
  password             String?   @db.VarChar(255)
  role                 String?   @default("User") @db.VarChar(255)
  status               String?   @default("active") @db.VarChar(50)
  createdAt            DateTime? @default(now()) @db.Timestamp(6)
  resetPasswordToken   String?   @db.VarChar(255)
  resetPasswordExpires DateTime? @db.Timestamp(6)
  must_change_password Boolean?  @default(false)
  created_by           Int?

  project_members        project_members[]
  created_boards         kanban_boards[]        @relation("BoardCreator")
  blockersLoggedBy       Blocker[]              @relation("BlockerLoggedBy")
  blockersHelpNeeded     Blocker[]              @relation("BlockerHelpNeededFrom")
  blockersResolved       Blocker[]              @relation("BlockerResolvedBy")
  organizedMeetings      Meeting[]              @relation("organizer")
  assignedActionItems    ActionItem[]           @relation("assignee")
  activity_logs_acted    activity_logs[]        @relation("ActivityActor")
  activity_logs_targeted activity_logs[]        @relation("ActivityTarget")
  task_attachments       task_attachments[]
  task_discussions       task_discussions[]
  task_discussion_reads  task_discussion_reads[]
  bug_attachments        bug_attachments[]
  bug_discussions        bug_discussions[]
  bug_discussion_reads   bug_discussion_reads[]
  blocker_attachments      blocker_attachments[]
  blocker_discussions      blocker_discussions[]
  blocker_discussion_reads blocker_discussion_reads[]
  
  // Sales Relations
  owned_projects         projects[]     @relation("ProjectOwner")
  owned_customers        Customer[]     @relation("CustomerOwner")
  owned_leads            Lead[]         @relation("LeadOwner")
  owned_opportunities    Opportunity[]  @relation("OpportunityOwner")
  owned_deals            Deal[]         @relation("DealOwner")
  created_quotations     Quotation[]    @relation("QuotationCreator")
  owned_follow_ups       FollowUp[]     @relation("FollowUpOwner")
  uploaded_documents     project_documents[]
  
  // Meeting Notes
  meetingNotesAuthored   MeetingNote[]  @relation("noteAuthor")
  meetingNotesUpdated    MeetingNote[]  @relation("noteUpdater")

  // Lead Notes
  leadNotesAuthored      LeadNote[]     @relation("LeadNoteAuthor")

  // Lead Interactions
  leadInteractions       LeadInteraction[] @relation("LeadInteractionAuthor")

  notifications          notifications[]
}

model bugs {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  description String?
  status      String    @default("open") @db.VarChar(50)
  priority    String    @default("medium") @db.VarChar(50)
  severity    String?   @db.VarChar(50)
  assignedTo  String?   @db.VarChar(255)
  reportedBy  String?   @db.VarChar(255)
  project_id         String?   @db.VarChar(255)
  sprint_id          String?   @db.VarChar(255)
  reproductionSteps  String?   @db.Text
  expectedResult     String?   @db.Text
  actualResult       String?   @db.Text
  resolutionNotes    String?   @db.Text
  environmentDetails String?   @db.Text
  createdAt          DateTime? @default(now()) @db.Timestamp(6)
  updatedAt          DateTime? @default(now()) @updatedAt @db.Timestamp(6)

  project     projects? @relation(fields: [project_id], references: [id], onDelete: Cascade)
  attachments          bug_attachments[]
  discussions          bug_discussions[]
  discussion_reads     bug_discussion_reads[]
}

model bug_attachments {
  id          Int          @id @default(autoincrement())
  bug_id      Int
  file_name   String       @db.VarChar(255)
  file_url    String       @db.Text
  file_size   Int
  description String?      @db.VarChar(500)
  uploaded_by Int
  uploaded_at DateTime     @default(now()) @db.Timestamp(6)
  
  bug         bugs         @relation(fields: [bug_id], references: [id], onDelete: Cascade)
  uploader    users        @relation(fields: [uploaded_by], references: [id], onDelete: Cascade)
}

model bug_discussions {
  id         Int          @id @default(autoincrement())
  bug_id     Int
  sender_id  Int
  message    String       @db.Text
  created_at DateTime     @default(now()) @db.Timestamp(6)
  updated_at DateTime     @default(now()) @updatedAt @db.Timestamp(6)

  bug        bugs         @relation(fields: [bug_id], references: [id], onDelete: Cascade)
  sender     users        @relation(fields: [sender_id], references: [id], onDelete: Cascade)
}

model bug_discussion_reads {
  id           Int          @id @default(autoincrement())
  bug_id       Int
  user_id      Int
  last_read_at DateTime     @default(now()) @db.Timestamp(6)

  bug          bugs         @relation(fields: [bug_id], references: [id], onDelete: Cascade)
  user         users        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([bug_id, user_id], map: "unique_bug_discussion_read")
}

model task_attachments {
  id          Int          @id @default(autoincrement())
  task_id     String       @db.VarChar(255)
  file_name   String       @db.VarChar(255)
  file_url    String       @db.Text
  file_size   Int
  uploaded_by Int
  uploaded_at DateTime     @default(now()) @db.Timestamp(6)
  
  task        kanban_tasks @relation(fields: [task_id], references: [id], onDelete: Cascade)
  uploader    users        @relation(fields: [uploaded_by], references: [id], onDelete: Cascade)
}

model task_discussions {
  id         Int          @id @default(autoincrement())
  task_id    String       @db.VarChar(255)
  sender_id  Int
  message    String       @db.Text
  created_at DateTime     @default(now()) @db.Timestamp(6)
  updated_at DateTime     @default(now()) @updatedAt @db.Timestamp(6)

  task       kanban_tasks @relation(fields: [task_id], references: [id], onDelete: Cascade)
  sender     users        @relation(fields: [sender_id], references: [id], onDelete: Cascade)
}

model task_discussion_reads {
  id           Int          @id @default(autoincrement())
  task_id      String       @db.VarChar(255)
  user_id      Int
  last_read_at DateTime     @default(now()) @db.Timestamp(6)

  task         kanban_tasks @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user         users        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([task_id, user_id], map: "unique_task_discussion_read")
}


model Blocker {
  id               Int       @id @default(autoincrement())
  title            String    @db.VarChar(255)
  description      String?
  severity         String    @db.VarChar(50)
  status           String    @default("open") @db.VarChar(50)
  escalationLevel  String    @default("none") @db.VarChar(50)
  projectId        String
  loggedById       Int
  helpNeededFromId Int?
  resolvedById     Int?
  resolvedAt       DateTime?
  tags             String[]  @db.VarChar(50)
  notes            String?
  createdAt        DateTime? @default(now()) @db.Timestamp(6)
  updatedAt        DateTime? @default(now()) @updatedAt @db.Timestamp(6)

  project        projects @relation(fields: [projectId], references: [id], onDelete: Cascade)
  loggedBy       users    @relation("BlockerLoggedBy", fields: [loggedById], references: [id], onDelete: Cascade)
  helpNeededFrom users?   @relation("BlockerHelpNeededFrom", fields: [helpNeededFromId], references: [id], onDelete: SetNull)
  resolvedBy     users?   @relation("BlockerResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  attachments          blocker_attachments[]
  discussions          blocker_discussions[]
  discussion_reads     blocker_discussion_reads[]
  activity_logs        activity_logs[]
}

model blocker_attachments {
  id          Int          @id @default(autoincrement())
  blocker_id  Int
  file_name   String       @db.VarChar(255)
  file_url    String       @db.Text
  file_size   Int
  description String?      @db.VarChar(500)
  uploaded_by Int
  uploaded_at DateTime     @default(now()) @db.Timestamp(6)
  
  blocker     Blocker      @relation(fields: [blocker_id], references: [id], onDelete: Cascade)
  uploader    users        @relation(fields: [uploaded_by], references: [id], onDelete: Cascade)
}

model blocker_discussions {
  id         Int          @id @default(autoincrement())
  blocker_id Int
  sender_id  Int
  message    String       @db.Text
  created_at DateTime     @default(now()) @db.Timestamp(6)
  updated_at DateTime     @default(now()) @updatedAt @db.Timestamp(6)

  blocker    Blocker      @relation(fields: [blocker_id], references: [id], onDelete: Cascade)
  sender     users        @relation(fields: [sender_id], references: [id], onDelete: Cascade)
}

model blocker_discussion_reads {
  id           Int          @id @default(autoincrement())
  blocker_id   Int
  user_id      Int
  last_read_at DateTime     @default(now()) @db.Timestamp(6)

  blocker      Blocker      @relation(fields: [blocker_id], references: [id], onDelete: Cascade)
  user         users        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([blocker_id, user_id], map: "unique_blocker_discussion_read")
}

model activity_logs {
  id             Int           @id @default(autoincrement())
  actor_user_id  Int
  target_user_id Int?
  project_id     String?       @db.VarChar(255)
  task_id        String?       @db.VarChar(255)
  blocker_id     Int?
  lead_id        Int?
  deal_id        Int?
  type           String        @db.VarChar(50)
  description    String
  created_at     DateTime      @default(now()) @db.Timestamp(6)
  actor          users         @relation("ActivityActor", fields: [actor_user_id], references: [id], onDelete: Cascade)
  project        projects?     @relation(fields: [project_id], references: [id], onDelete: SetNull)
  target         users?        @relation("ActivityTarget", fields: [target_user_id], references: [id], onDelete: SetNull)
  task           kanban_tasks? @relation(fields: [task_id], references: [id], onDelete: SetNull)
  blocker        Blocker?      @relation(fields: [blocker_id], references: [id], onDelete: SetNull)
  lead           Lead?         @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  deal           Deal?         @relation(fields: [deal_id], references: [id], onDelete: SetNull)

}

// =============================
// Meeting Management Module
// =============================

enum MeetingType {
  DAILY_STANDUP
  SPRINT_PLANNING
  SPRINT_REVIEW
  RETROSPECTIVE
  CLIENT_MEETING
  INTERNAL_DISCUSSION
  BUG_REVIEW
  EMERGENCY_MEETING
  OTHER
}

enum MeetingStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum ActionItemPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Meeting {
  id           Int              @id @default(autoincrement())
  title        String           @db.VarChar(255)
  description  String?
  projectId    String
  meetingType  MeetingType
  status       MeetingStatus    @default(SCHEDULED)
  meetingDate  DateTime
  startTime    String           @db.VarChar(20)
  endTime      String           @db.VarChar(20)
  location     String?
  meetingLink  String?
  googleEventId String?
  organizerId  Int
  attendees    Int[]            // Array of user IDs
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  project      projects         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizer    users            @relation("organizer", fields: [organizerId], references: [id], onDelete: Cascade)
  actionItems  ActionItem[]
  notesList    MeetingNote[]
}

model ActionItem {
  id          Int                @id @default(autoincrement())
  meetingId   Int
  title       String             @db.VarChar(255)
  description String?
  assignedTo  Int                // userId
  dueDate     DateTime?
  status      ActionItemStatus   @default(OPEN)
  priority    ActionItemPriority @default(MEDIUM)
  createdAt   DateTime           @default(now())

  meeting     Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignee    users              @relation("assignee", fields: [assignedTo], references: [id], onDelete: Cascade)
}

model MeetingNote {
  id        Int      @id @default(autoincrement())
  meetingId Int
  title     String   @db.VarChar(255)
  content   String   @db.Text
  createdBy Int
  updatedBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  author    users    @relation("noteAuthor", fields: [createdBy], references: [id], onDelete: Cascade)
  updater   users?   @relation("noteUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
}

// =============================
// Sales Module
// =============================

model Customer {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  email     String?  @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  company   String?  @db.VarChar(255)
  industry  String?  @db.VarChar(100)
  website   String?  @db.VarChar(255)
  address   String?
  status    String   @default("active") @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerId   Int

  owner         users         @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  leads         Lead[]
  opportunities Opportunity[]
  deals         Deal[]
  quotations    Quotation[]
}

model Lead {
  id               Int       @id @default(autoincrement())
  title            String    @db.VarChar(255)
  description      String?
  source           String    @default("manual") @db.VarChar(100)
  flaggedForReview Boolean   @default(false)
  status           String    @default("new") @db.VarChar(50)
  // Pipeline stage. Every lead always belongs to exactly one stage (see LeadStage).
  stage            String    @default("New") @db.VarChar(100)
  // Ordering of the card within its pipeline column.
  orderIndex       Int       @default(0) @map("order_index")
  priority         String    @default("medium") @db.VarChar(50)
  score            Int       @default(0)
  tags             String?
  // Reason captured when a lead is disqualified (status = "disqualified").
  disqualifyReason String?   @map("disqualify_reason")
  customerId       Int?
  ownerId          Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer      Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  owner         users             @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  followUps     FollowUp[]        @relation("LeadFollowUps")
  activityLogs  activity_logs[]
  notes         LeadNote[]
  interactions  LeadInteraction[]
  convertedDeal Deal?             @relation("LeadConvertedDeal")
}

/**
 * Customer interaction logged against a lead (Call / Email / Meeting).
 * Feeds the interaction timeline, responsiveness/interaction scoring factors,
 * and follow-up reminder scheduling.
 */
model LeadInteraction {
  id              Int      @id @default(autoincrement())
  leadId          Int      @map("lead_id")
  authorId        Int      @map("author_id")
  type            String   @db.VarChar(20) // Call | Email | Meeting
  notes           String
  interactionDate DateTime @map("interaction_date")
  createdAt       DateTime @default(now()) @map("created_at")

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author users @relation("LeadInteractionAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@map("lead_interactions")
}

/**
 * Admin-configured lead scoring factors and weights. The scoring engine
 * normalises active criteria into a 1–100 score. `factor` is a stable key
 * (e.g. "interest_level"); `label` is the human-readable name.
 */
model LeadScoringCriterion {
  id        Int      @id @default(autoincrement())
  factor    String   @unique @db.VarChar(100)
  label     String   @db.VarChar(150)
  weight    Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("lead_scoring_criteria")
}

/**
 * Lead pipeline stages. Seeded with the default ordered set
 * (New → Contacted → Interested → Negotiating) during DB init. Drives the
 * pipeline board columns, analytics ordering and lead progression.
 */
model LeadStage {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(100)
  orderIndex Int      @map("order_index")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("lead_stages")
}

/**
 * Free-text notes attached to a lead — a historical communication log.
 */
model LeadNote {
  id        Int      @id @default(autoincrement())
  leadId    Int      @map("lead_id")
  authorId  Int      @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author users @relation("LeadNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@map("lead_notes")
}

model Opportunity {
  id            Int       @id @default(autoincrement())
  title         String    @db.VarChar(255)
  description   String?
  value         Float     @default(0)
  stage         String    @default("discovery") @db.VarChar(50)
  probability   Int       @default(10)
  expectedClose DateTime?
  customerId    Int
  ownerId       Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  owner    users    @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  deals    Deal[]
}

model Deal {
  id            Int       @id @default(autoincrement())
  title         String    @db.VarChar(255)
  amount        Float     @default(0)
  // ISO currency code for the deal value. INR is the business default.
  currency      String    @default("INR") @db.VarChar(10)
  status        String    @default("open") @db.VarChar(50)
  // Pipeline stage. Every deal always belongs to exactly one stage (see DealStage).
  stage         String    @default("Proposal Sent") @db.VarChar(100)
  // Win probability (0–100). Defaults follow the stage, can be overridden.
  probability   Int       @default(20)
  // Forecasting / pipeline hygiene timestamps.
  expectedCloseDate DateTime? @map("expected_close_date")
  closedAt          DateTime? @map("closed_at")
  orderIndex    Int       @default(0) @map("order_index")
  // Origin source carried over from the converted lead (if any).
  source        String?   @db.VarChar(100)
  notes         String?
  // Optional commercial context (free text / comma-separated lists).
  products      String?
  services      String?
  competitors   String?
  attachments   String?
  // Win/Loss intelligence — exact reason text captured on close.
  winReason     String?   @map("win_reason")
  lossReason    String?   @map("loss_reason")
  // Deal Won Event idempotency marker (set once downstream processing succeeds).
  wonEventAt    DateTime? @map("won_event_at")
  // Guards the "close date approaching" reminder from re-notifying.
  closeReminderNotified Boolean @default(false) @map("close_reminder_notified")
  // The lead this deal was converted from (one lead → at most one deal).
  leadId        Int?      @unique
  // Optional cross-module linkage for future ERP expansion (id only, no FK).
  projectId     String?   @map("project_id") @db.VarChar(255)
  opportunityId Int?
  customerId    Int
  ownerId       Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lead         Lead?           @relation("LeadConvertedDeal", fields: [leadId], references: [id], onDelete: SetNull)
  opportunity  Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  owner        users           @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  quotations   Quotation[]
  followUps    FollowUp[]      @relation("DealFollowUps")
  activityLogs activity_logs[]
}

/**
 * Deal pipeline stages. Seeded with the default ordered set during DB init.
 * Drives the deal board, deal analytics and conversion metrics.
 */
model DealStage {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(100)
  orderIndex Int      @map("order_index")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("deal_stages")
}

model Quotation {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  totalAmount Float     @default(0)
  status      String    @default("draft") @db.VarChar(50)
  validUntil  DateTime?
  dealId      Int?
  customerId  Int
  createdBy   Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  creator   users    @relation("QuotationCreator", fields: [createdBy], references: [id], onDelete: Cascade)
}

model FollowUp {
  id            Int       @id @default(autoincrement())
  title         String    @db.VarChar(255)
  notes         String?
  scheduledDate DateTime
  status        String    @default("pending") @db.VarChar(50)
  // Reminder type: initial | call | follow_up | proposal_review | manual.
  // Drives duplicate-prevention and reminder rules.
  type          String    @default("follow_up") @db.VarChar(50)
  // Set once a due/overdue notification has been emitted (prevents spam).
  reminderNotified Boolean @default(false)
  completedAt   DateTime?
  leadId        Int?
  dealId        Int?
  ownerId       Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lead  Lead?  @relation("LeadFollowUps", fields: [leadId], references: [id], onDelete: Cascade)
  deal  Deal?  @relation("DealFollowUps", fields: [dealId], references: [id], onDelete: Cascade)
  owner users  @relation("FollowUpOwner", fields: [ownerId], references: [id], onDelete: Cascade)
}

model notifications {
  id          Int      @id @default(autoincrement())
  user_id     Int
  type        String   @db.VarChar(50)
  title       String   @db.VarChar(255)
  message     String   @db.Text
  entity_type String   @db.VarChar(50)
  entity_id   Int
  is_read     Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  
  user        users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model project_documents {
  id          Int      @id @default(autoincrement())
  project_id  String   @db.VarChar(255)
  title       String   @db.VarChar(255)
  description String?  @db.Text
  file_name   String   @db.VarChar(255)
  file_url    String   @db.Text
  mime_type   String   @db.VarChar(100)
  file_size   Int
  uploaded_by Int
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(6)

  project     projects @relation(fields: [project_id], references: [id], onDelete: Cascade)
  uploader    users    @relation(fields: [uploaded_by], references: [id], onDelete: Cascade)
}
